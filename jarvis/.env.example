# Copy this file to ".env" (or just use the Settings screen in the HUD, which writes it for you).
# .env is private: it is git-ignored and never leaves this computer except to call ElevenLabs.

# --- Voice (ElevenLabs) ---
ELEVENLABS_API_KEY=
# Any voice in your ElevenLabs account. Default is "George", a stock ElevenLabs voice.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2

# --- You and Jarvis ---
JARVIS_NAME=Jarvis
JARVIS_ADDRESS=boss
# Folder shown as the galaxy and readable by Jarvis without asking (default: your Documents folder).
JARVIS_BRAIN_DIR=
# Jarvis's own working folder (default: ~/Jarvis).
JARVIS_HOME=

# --- Brain (Claude Code) ---
# Blank = whatever your Claude Code uses by default. Or: fable, opus, sonnet, haiku, or a full model id.
JARVIS_MODEL=
# Blank = default. low gives the snappiest voice replies; high thinks harder.
JARVIS_EFFORT=
# 1 = start Claude Code with the Claude in Chrome integration so Jarvis can drive your browser (experimental).
JARVIS_CHROME=0

JARVIS_PORT=4747
