{
  "name": "jarvis-companion",
  "productName": "Jarvis",
  "version": "0.1.0",
  "description": "Personal desktop voice companion: ElevenLabs voice, Claude/OpenAI brain, floating character overlay.",
  "author": "NVICTUS Enterprise LLC",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "package:win": "npm run build && electron-builder --win portable nsis",
    "package:win:portable": "npm run build && electron-builder --win portable",
    "package:win:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
